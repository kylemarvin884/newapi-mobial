# Runtime mode. Production disables the interactive API docs.
ENVIRONMENT=production

# Required: your NewAPI root URL, without /api or a trailing slash.
NEWAPI_BASE_URL=https://newapi.example.com

# Keep this value when Redis runs through the included Docker Compose file.
REDIS_URL=redis://redis:6379/0

# Required: generate a unique value with `openssl rand -hex 32`.
# Changing it invalidates all existing mobile sessions.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Session lifetime (30 days) and upstream request timeout, in seconds.
SESSION_TTL_SECONDS=2592000
REQUEST_TIMEOUT_SECONDS=60

# Must match the quota unit configured by your NewAPI instance.
QUOTA_PER_UNIT=500000
CURRENCY_SYMBOL=¥

# JSON array. Native apps normally use []; browser clients need explicit origins.
# Example: ["https://web.example.com"]
CORS_ORIGINS=[]
