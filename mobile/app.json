{
  "expo": {
    "name": "NewAPI Mobile",
    "slug": "newapi-mobile",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ios.png",
    "scheme": "newapimobile",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.newapimobile",
      "icon": "./assets/icon-ios.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-ios.png",
        "backgroundColor": "#F7FAF9"
      },
      "package": "com.example.newapimobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-ios.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "appName": "NewAPI Mobile",
      "storageNamespace": "newapi-mobile"
    }
  }
}
